<?xml version="1.0" encoding="utf-8"?>
<!--
  Native Ad — list-tile layout. Factory ID: "listTile"
  ALL views inside NativeAdView. Badge = advertiserView (validator fix).
  MediaView = 120dp height minimum (Google validator requirement).
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- ── Media (≥120dp required by AdMob) ─────────────────────── -->
        <com.google.android.gms.ads.nativead.MediaView
            android:tag="media"
            android:layout_width="match_parent"
            android:layout_height="120dp"/>

        <!-- ── Info row ───────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp">

            <!-- Icon -->
            <ImageView
                android:tag="icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:background="@drawable/ad_icon_bg"/>

            <!-- Text block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:tag="headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:tag="body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp"/>

                <!--
                  Badge wired as advertiserView — inside NativeAdView boundary.
                  Satisfies "Advertiser assets outside native ad view" check.
                -->
                <TextView
                    android:tag="advertiser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إعلان"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#AC1A37"
                    android:background="@drawable/ad_badge_bg"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>

            <!-- CTA -->
            <TextView
                android:tag="cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/ad_cta_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>

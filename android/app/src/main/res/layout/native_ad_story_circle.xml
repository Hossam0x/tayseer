<?xml version="1.0" encoding="utf-8"?>
<!--
  Native Ad — story-circle layout. Factory ID: "storyCircle"
  MediaView = 120×120dp (AdMob minimum). Badge = advertiserView.
  Used inside StoryDetailsView interstitial transitions only (not in the row).
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="4dp">

        <!--
          Gradient ring container — 128dp so inner MediaView is ≥120dp.
          The 4dp ring thickness on each side → MediaView = 120dp square.
        -->
        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:background="@drawable/ad_story_ring">

            <!-- MediaView ≥ 120×120dp — satisfies AdMob validator -->
            <com.google.android.gms.ads.nativead.MediaView
                android:tag="media"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/ad_icon_bg"/>
        </FrameLayout>

        <!-- Headline (story / sponsor name) -->
        <TextView
            android:tag="headline"
            android:layout_width="128dp"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:layout_marginTop="4dp"/>

        <!--
          Badge wired as advertiserView — inside NativeAdView boundary.
          Satisfies "Advertiser assets outside native ad view" check.
        -->
        <TextView
            android:tag="advertiser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إعلان"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#AC1A37"
            android:background="@drawable/ad_badge_bg"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>

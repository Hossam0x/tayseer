<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- Basic App Info -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Tayseer</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.athr.tayser</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>tayseer</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- ✅ URL Launcher Schemes (NEW) -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>https</string>
        <string>http</string>
        <string>tel</string>
        <string>mailto</string>
    </array>

    <!-- Network -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <!-- Camera + Microphone -->
    <key>NSCameraUsageDescription</key>
    <string>يستخدم التطبيق الكاميرا لالتقاط صورة للملف الشخصي ومشاركة الصور أو الفيديوهات داخل التطبيق.</string>

    <key>NSMicrophoneUsageDescription</key>
    <string>يستخدم التطبيق الميكروفون لتسجيل الرسائل الصوتية أو أثناء مكالمات الصوت أو الفيديو داخل التطبيق.</string>

    <!-- Photos -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>يستخدم التطبيق مكتبة الصور لاختيار الصور أو الفيديوهات ومشاركتها داخل التطبيق.</string>

    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>يستخدم التطبيق حفظ الصور أو الفيديوهات التي ينشئها المستخدم داخل مكتبة الصور.</string>

    <!-- Media & Files -->
    <key>NSAppleMusicUsageDescription</key>
    <string>يستخدم التطبيق الوصول إلى الملفات الصوتية لاختيار ومشاركة المقاطع الصوتية داخل التطبيق.</string>

    <!-- Location -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>يستخدم التطبيق موقعك لتقديم خدمات تعتمد على الموقع مثل عرض المستخدمين أو الخدمات القريبة منك.</string>

    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>يستخدم التطبيق موقعك لتحسين الخدمات المرتبطة بالموقع حتى عند تشغيل التطبيق في الخلفية.</string>

    <key>NSLocationAlwaysUsageDescription</key>
    <string>يستخدم التطبيق موقعك بشكل مستمر لتحسين تجربة الخدمات المعتمدة على الموقع.</string>

    <!-- Bluetooth -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>يستخدم التطبيق البلوتوث للاتصال بالأجهزة الصوتية مثل السماعات أثناء المكالمات الصوتية أو الفيديو.</string>

    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>يستخدم التطبيق البلوتوث للتواصل مع الأجهزة الصوتية المتصلة بالجهاز.</string>

    <!-- Motion -->
    <key>NSMotionUsageDescription</key>
    <string>يستخدم التطبيق بيانات الحركة لتحسين تجربة التصوير أو عرض المحتوى بشكل أفضل.</string>

    <!-- Photo Library Limited Access (iOS 14+) -->
    <key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
    <true/>

    <key>NSPhotoLibraryLimitedUsageDescription</key>
    <string>يستخدم التطبيق الصور المحددة فقط من مكتبتك لاختيار ومشاركة المحتوى داخل التطبيق.</string>

    <!-- Notifications -->
    <key>NSUserNotificationAlertStyle</key>
    <string>alert</string>

    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>remote-notification</string>
        <string>audio</string>
        <string>voip</string>
    </array>

    <!-- Firebase -->
    <key>FirebaseAppDelegateProxyEnabled</key>
    <true/>

    <!-- Google Maps SDK -->
    <key>GMSApiKey</key>
    <string>AIzaSyBwj3AABMp5Sw9qpkfR1ByoBdrF1djZzFQ</string>

    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!-- Launch / Main Storyboards -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <!-- Supported Orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Google Sign-In -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>REVERSED_CLIENT_ID</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.googleusercontent.apps.267720438243-bl25r1jul2309brv15kl7hr19oar6q5f</string>
            </array>
        </dict>
    </array>

</dict>
</plist>

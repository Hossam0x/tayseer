<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- Basic App Info -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Tayseer</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.athr.tayser</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>tayseer</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Network -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <!-- Camera + Microphone -->
    <key>NSCameraUsageDescription</key>
    <string>يحتاج التطبيق الوصول للكاميرا لالتقاط الصور والفيديوهات</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>يحتاج التطبيق الوصول للميكروفون لتسجيل الصوت</string>

    <!-- Photos -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>يحتاج التطبيق الوصول لمكتبة الصور لاختيار الصور والفيديوهات</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>يحتاج التطبيق إضافة الصور والفيديوهات إلى مكتبة الصور</string>

    <!-- ✅✅✅ أضف ده للـ Audio Files (مهم جداً لـ file_picker على iOS) -->
    <key>NSAppleMusicUsageDescription</key>
    <string>يحتاج التطبيق الوصول للملفات الصوتية لرفعها</string>
    
    <!-- ✅✅✅ أضف ده كمان للـ Media Library (iOS 14+) -->
    <key>kTCCServiceMediaLibrary</key>
    <string>يحتاج التطبيق الوصول لمكتبة الوسائط لاختيار الملفات الصوتية</string>

    <!-- Location -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>يحتاج التطبيق الوصول لموقعك لتقديم خدمات الموقع داخل التطبيق</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>يحتاج التطبيق الوصول لموقعك لتقديم خدمات الموقع حتى عند عدم استخدام التطبيق</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>يحتاج التطبيق الوصول لموقعك بشكل دائم لتحديثات الموقع</string>

    <!-- Notifications -->
    <key>NSUserNotificationAlertStyle</key>
    <string>alert</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>

    <!-- Firebase -->
    <key>FirebaseAppDelegateProxyEnabled</key>
    <true/>

    <!-- Google Maps SDK -->
    <key>GMSApiKey</key>
    <string>AIzaSyBwj3AABMp5Sw9qpkfR1ByoBdrF1djZzFQ</string>

    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!-- Launch / Main Storyboards -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <!-- Supported Orientations (iPhone + iPad) -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Google Sign-In URL Schemes -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>REVERSED_CLIENT_ID</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.googleusercontent.apps.267720438243-bl25r1jul2309brv15kl7hr19oar6q5f</string>
            </array>
        </dict>
    </array>

</dict>
</plist>